# Copy to .env for local runs (never commit secrets).

HF_TOKEN=hf_xxxxxxxx

# Source corpus (read)
SOURCE_DATASET=galsenai/cleaned_data_for_clm
# SOURCE_CONFIG=
SOURCE_SPLIT=train
SOURCE_TEXT_COLUMN=text
# SOURCE_ID_COLUMN=

# Annotation stores (read/write) — use your org / username
VOTES_DATASET=galsenai/wolof_orthography_votes
CONSENSUS_DATASET=galsenai/wolof_orthography_consensus

# 2 or 3 is typical
CONSENSUS_THRESHOLD=2

# Cap source rows in memory (0 = load entire split)
SOURCE_MAX_ROWS=50000

MAX_TEXT_CHARS=1200
APP_TITLE=Wolof Orthography Annotator
REQUIRE_VOLUNTEER_ID=true
